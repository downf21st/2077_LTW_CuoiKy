# SMTP server
NEWSLETTER_SMTP_HOST=
NEWSLETTER_SMTP_PORT=587
NEWSLETTER_SMTP_SECURE=false
NEWSLETTER_SMTP_USER=
NEWSLETTER_SMTP_PASS=
NEWSLETTER_FROM=

# Public URLs used in recipe and unsubscribe links
NEWSLETTER_SERVER_URL=http://localhost:5000
NEWSLETTER_CLIENT_URL=http://localhost:5173

# Default: every day at 09:00 in Vietnam time
NEWSLETTER_CRON=0 9 * * *
NEWSLETTER_TIMEZONE=Asia/Ho_Chi_Minh
